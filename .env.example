# Copiar a .env y reemplazar los valores. .env NO se sube a Git.

# Versiones fijas de las imágenes oficiales (actualizar a propósito, nunca "latest")
ODOO_IMAGE=odoo:19.0-20261015
POSTGRES_IMAGE=postgres:17.11-bookworm

# PostgreSQL (solo accesible desde la red interna de Docker)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar-esta-clave

# Contraseña maestra de Odoo (gestor de bases de datos: crear, respaldar, restaurar, borrar)
ODOO_MASTER_PASSWORD=cambiar-esta-clave-maestra

# Puerto local. Se publica solo en 127.0.0.1
ODOO_HTTP_PORT=8069

# Administrador de la base de prueba (usado por scripts/create-db.ps1)
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=cambiar-clave-admin
